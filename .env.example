# .env.example
# ------------
# This file is just a REFERENCE showing which environment variables the
# bot needs - it's tracked in git safely because it has no real values.
#
# Do NOT fill in real values here and commit them. Set these as actual
# environment variables on each device instead (see GITHUB_ACTIONS_DEPLOY.md
# and README.md "Angel One SmartAPI setup" / "Telegram alerts" for exact
# steps per OS). If you do create a real ".env" file locally for your own
# convenience, .gitignore already excludes it from being committed.

# Angel One SmartAPI (see README.md "Angel One SmartAPI setup")
ANGELONE_API_KEY=
ANGELONE_CLIENT_CODE=
ANGELONE_PIN=
ANGELONE_TOTP_SECRET=

# Telegram bot (see README.md "Telegram alerts")
TB_TELEGRAM_TOKEN=
TB_TELEGRAM_CHAT_ID=
