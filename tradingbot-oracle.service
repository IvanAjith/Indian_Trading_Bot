[Unit]
Description=NSE Options Trading Bot (paper trading monitor) - Oracle Cloud
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/trading-bot
EnvironmentFile=/home/ubuntu/trading-bot/.env
ExecStart=/usr/bin/python3 -u /home/ubuntu/trading-bot/main.py --mode monitor --paper --broker angelone
Restart=always
RestartSec=10
StandardOutput=append:/home/ubuntu/trading-bot/monitor.log
StandardError=append:/home/ubuntu/trading-bot/monitor.log

[Install]
WantedBy=multi-user.target
